{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bootstrap.sh >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task"
    ],
    "deny": [
      "Read(./offline/**)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo rm -fr:*)",
      "Bash(/bin/rm -rf:*)",
      "Bash(/bin/rm -fr:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",

      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*:*)",
      "Bash(fdisk:*)",
      "Bash(sfdisk:*)",
      "Bash(cfdisk:*)",
      "Bash(parted:*)",
      "Bash(wipefs:*)",
      "Bash(blkdiscard:*)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(sudo mount:*)",
      "Bash(sudo umount:*)",

      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(poweroff:*)",
      "Bash(halt:*)",
      "Bash(init 0:*)",
      "Bash(init 6:*)",
      "Bash(telinit:*)",
      "Bash(systemctl poweroff:*)",
      "Bash(systemctl reboot:*)",
      "Bash(systemctl halt:*)",
      "Bash(sudo shutdown:*)",
      "Bash(sudo reboot:*)",
      "Bash(sudo poweroff:*)",
      "Bash(sudo halt:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod 777 /:*)",
      "Bash(sudo chmod -R:*)",
      "Bash(chown -R:*)",
      "Bash(sudo chown -R:*)",
      "Bash(kill -9 -1:*)",
      "Bash(killall -9:*)"
    ]
  }
}
