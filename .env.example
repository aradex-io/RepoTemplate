# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Document every variable the project needs here with a safe placeholder.

# Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname
# API_KEY=changeme

# Used by scripts/codex-review.sh (optional). Default model gpt-5.6-sol — the
# codex default gpt-5.3-codex fails on ChatGPT-account auth. Effort: none|minimal|
# low|medium|high|xhigh|max (default xhigh).
# CODEX_REVIEW_MODEL=gpt-5.6-sol
# CODEX_REVIEW_EFFORT=xhigh
